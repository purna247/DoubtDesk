# DoubtDesk v1 Environment Configuration Template
# Copy this file to .env and configure your local credentials and API keys.

APP_NAME=DoubtDesk
APP_ENV=development
DEBUG=true
SECRET_KEY=doubtdesk-local-insecure-secret-key-change-in-production-1234567890
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Configuration (PostgreSQL 16/18 with pgvector extension)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=doubtdesk
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/doubtdesk
DATABASE_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Super Admin Initial Bootstrap Credentials (used by python -m app.seed)
SUPERADMIN_EMAIL=superadmin@doubtdesk.platform
SUPERADMIN_PASSWORD=SuperAdminPass123!
SUPERADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# AI / Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-3-flash-preview
GEMINI_REPAIR_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=24000

# Session & Security
SESSION_COOKIE_NAME=doubtdesk_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
MFA_ISSUER_NAME=DoubtDesk Platform
MFA_TOKEN_MAX_AGE_SECONDS=300

# File Storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=local_storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Pedagogical Defaults
WEAKNESS_ACCURACY_THRESHOLD=0.60
MIN_DISTINCT_QUESTIONS_THRESHOLD=3
BOSS_ARENA_DEFAULT_COOLDOWN_HOURS=24

# Background Worker & Frontend
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_LEASE_SECONDS=300
VITE_API_URL=http://localhost:8000
