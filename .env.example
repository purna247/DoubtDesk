# Canonical local configuration for Docker Compose, API, worker, and seed command.
# Copy to v1/.env. Use unique production credentials and a generated SECRET_KEY.

APP_NAME=DoubtDesk
APP_ENV=development
DEBUG=true
SECRET_KEY=doubtdesk-local-insecure-secret-key-change-in-production-1234567890
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL 16 / pgvector (local development defaults only)
POSTGRES_USER=doubtdesk
POSTGRES_PASSWORD=doubtdesk
POSTGRES_DB=doubtdesk
DATABASE_URL=postgresql+asyncpg://doubtdesk:doubtdesk@localhost:5432/doubtdesk
DATABASE_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Initial Super Admin bootstrap. Set all three before running `python -m app.seed`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_TOTP_SECRET=

# Optional AI provider. Core local workflows do not require an API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash
GEMINI_REPAIR_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=24000

# Session and MFA
SESSION_COOKIE_NAME=doubtdesk_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
MFA_ISSUER_NAME=DoubtDesk Platform
MFA_TOKEN_MAX_AGE_SECONDS=300

# Local file storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=local_storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Pedagogical defaults
WEAKNESS_ACCURACY_THRESHOLD=0.60
MIN_DISTINCT_QUESTIONS_THRESHOLD=3
BOSS_ARENA_DEFAULT_COOLDOWN_HOURS=24

# Worker and frontend
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_LEASE_SECONDS=300
VITE_API_URL=http://localhost:8000
